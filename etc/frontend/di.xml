<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Smile\ElasticsuiteCatalog\Block\Navigation">
        <plugin name="buhmann_catalog_elasticsuite_navigation" type="Buhmann\CatalogSmile\Plugin\Block\Navigation" sortOrder="10" />
    </type>
    <type name="Smile\ElasticsuiteCore\Search\Request\ContainerConfiguration">
        <plugin name="buhmann_catalog_force_container_bucket_size" type="Buhmann\CatalogSmile\Plugin\Search\Request\ContainerConfiguration" />
    </type>

    <type name="Buhmann\Catalog\Plugin\Controller\CategoryView">
        <plugin name="vendor_custom_catalog_extend_filter_metadata" type="Buhmann\CatalogSmile\Plugin\Controller\ExtendFilterMetadataPlugin" sortOrder="10" />
    </type>

    <type name="Magento\CatalogSearch\Model\Layer\Filter\Attribute">
        <plugin name="buhmann_catalog_attribute_filter_apply" disabled="true" />
    </type>
    <type name="Magento\Catalog\Model\Layer\Filter\Item">
        <plugin name="buhmann_catalog_filter_item" disabled="true" />
    </type>
</config>
